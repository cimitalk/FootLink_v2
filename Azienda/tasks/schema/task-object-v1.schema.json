{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cimitalk/FootLink_v2/tasks/schema/task-object-v1.schema.json",
  "title": "Footlink Task Object Schema v1.0",
  "description": "Canonical JSON Schema for Footlink C-Suite tasks managed in Google Antigravity and GitHub.",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "description",
    "status",
    "priority",
    "assignee_role",
    "assignee_agent",
    "created_by",
    "created_at",
    "updated_at",
    "due_date",
    "estimated_effort",
    "actual_effort",
    "dependencies",
    "blocked_by",
    "output_artifacts",
    "requires_escalation",
    "escalation_reason",
    "escalation_level",
    "decision_record_id",
    "tags",
    "acceptance_criteria",
    "notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^FTL-(GOV|CEO|TECH|PROD|REV|MKT)-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "todo",
        "in_progress",
        "review",
        "done",
        "blocked",
        "paused_ai_quota",
        "cancelled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "assignee_role": {
      "type": "string",
      "enum": ["CEO", "CTO", "CPO", "CRO", "CGO", "CMO"]
    },
    "assignee_agent": {
      "type": ["string", "null"]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": ["string", "null"]
    },
    "estimated_effort": {
      "type": "string",
      "enum": ["XS (<2h)", "S (2-8h)", "M (1-3gg)", "L (3-10gg)", "XL (>10gg)"]
    },
    "actual_effort": {
      "type": ["string", "null"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FTL-(GOV|CEO|TECH|PROD|REV|MKT)-[0-9]{3}$"
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_escalation": {
      "type": "boolean"
    },
    "escalation_reason": {
      "type": ["string", "null"]
    },
    "escalation_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]
    },
    "decision_record_id": {
      "type": ["string", "null"],
      "pattern": "^ADR-[0-9]{3}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PLM",
          "PIM",
          "infra",
          "governance",
          "sales",
          "marketing",
          "product",
          "finops"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
