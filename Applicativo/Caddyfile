# Caddyfile for Footlink Self-Hosted Production (Zero-maintenance Automatic HTTPS)
app.footlink.eu, localhost {
    encode gzip zstd

    # Frontend SPA static files
    root * /var/www/html
    file_server

    # API Proxy to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /health* {
        reverse_proxy backend:8000
    }

    # SPA Client-Side Routing fallback
    try_files {path} /index.html
}
